root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cmd,ps1}]
end_of_line = crlf
indent_size = 4

[*.{sh,command,js,json,md,yml,conf,tsv,html}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

[*.tsv]
indent_style = tab
trim_trailing_whitespace = false
